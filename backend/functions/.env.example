# --- Local development: copy to .env.local (never deployed) ---
DATABASE_URL=postgres://amoura:amoura@localhost:5432/amoura
DEV_AUTH=true
FRONTEND_ORIGINS=http://localhost:3000
MODERATION=off
GOOGLE_VISION_KEY=

# --- Production: put NON-secret settings in functions/.env (deployed with the function) ---
#   FRONTEND_ORIGINS=https://your-app.vercel.app
#   MODERATION=vision
#   PGSSL=true
# Secrets are stored in Firebase instead:
#   firebase functions:secrets:set DATABASE_URL
#   (GOOGLE_VISION_KEY can be added the same way if you use moderation)
# DEV_AUTH must never be set in production. The API refuses to start with it in the cloud.
